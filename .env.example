# Vercel Postgres — automatically set when you link a Vercel Postgres database.
# For local dev: run `vercel env pull .env.local` after linking the DB in your Vercel project.
POSTGRES_URL=

# Google Places API key — https://console.cloud.google.com/
# Enable: Places API
GOOGLE_PLACES_API_KEY=

# Yelp Fusion API key — https://docs.developer.yelp.com/
YELP_API_KEY=
